<?xml version="1.0" encoding="UTF-8"?>

<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="community-cordova-plugin-wifi"
        version="1.1.0">
    <name>Cordova Plugin Wifi</name>
    <description></description>
    <license>MIT</license>
    <keywords></keywords>
    <repo>https://github.com/eyalin/community-cordova-plugin-wifi.git</repo>
    <issue>https://github.com/eyalin/community-cordova-plugin-wifi/issues</issue>

    <!-- android -->
    <platform name="android">
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
            <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
            <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
            <uses-permission android:name="android.permission.INTERNET"/>
        </config-file>
        <js-module src="www/plugin.js" name="WifiPlugin">
            <runs/>

            <!-- This is the window variable name you want, like window.WifiPlugin -->
            <clobbers target="WifiPlugin" />
        </js-module>
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="WifiPlugin">
                <param name="android-package" value="wifiplugin.WifiPlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <source-file src="src/android/WifiPlugin.java" target-dir="src/android" />
        <source-file src="src/android/IpInfoUtils.java" target-dir="src/android" />
        <source-file src="src/android/WifiDetailsUtils.java" target-dir="src/android" />
        <source-file src="src/android/WifiUtils.java" target-dir="src/android" />
    </platform>

    <!-- ios -->
    <platform name="ios">
        <js-module src="www/plugin.js" name="plugin">
            <runs/>
            <clobbers target="WifiPlugin" />
        </js-module>
        <config-file target="config.xml" parent="/*">
            <feature name="WifiPlugin">
                <param name="ios-package" value="WifiPlugin" onload="true" />
            </feature>
        </config-file>

        <config-file target="App/App-Info.plist" parent="NSLocationWhenInUseUsageDescription">
            <string>Your location is used to access WiFi information.</string>
        </config-file>
        <config-file target="App/App-Info.plist" parent="NSLocationAlwaysAndWhenInUseUsageDescription">
            <string>Your location is used to access WiFi information even when the app is in the background.</string>
        </config-file>

        <!--
          NEHotspotNetwork (used to read SSID/BSSID/signalStrength/isSecure) requires the
          "Access WiFi Information" entitlement. It is OPT-IN so apps that never read the SSID
          on iOS don't get an unused capability: install with the WIFI_INFO_ENTITLEMENT variable
          set to true, and the after_prepare hook writes
          com.apple.developer.networking.wifi-info into Entitlements-Debug/Release.plist.
          The App ID must also have "Access WiFi Information" enabled in the Apple Developer
          portal - a plugin cannot grant the capability itself. See README.
        -->
        <preference name="WIFI_INFO_ENTITLEMENT" default="false" />
        <hook type="after_prepare" src="hooks/ios-wifi-info-entitlement.js" />

        <framework src="NetworkExtension.framework" />

        <header-file src="src/ios/WifiPlugin.h" />
        <source-file src="src/ios/WifiPlugin.m" />
    </platform>
</plugin>
